    "content": "The 520 total due on invoice INV-2207 equals the sum of its line items.",
    "content_hash": "0x0e0fbbd59d442f2c89d0429599af9b4b14554a808cef9872f61ee41a2a9b0da5",
    "creator_votes": 0,
    "deployment": {
      "abi_version": 1,
      "chain_id": 31337,
      "code_hash": "0xf3d11eb4b6553547aad3ce66820256ac46373e1f0fbb2771efe00bff6fc245ab",
      "confirmation_depth": 1,
